#ifndef _OCEAN_FFT_H_
#define _OCEAN_FFT_H_

#define PI 3.14159265358979323846

//JONSWAP 结构体
struct JONSWAP_parameters
{
    float scale;
	float angle;
	float spreadBlend;
	float swell;
	float alpha;
	float peakOmega;
	float gamma;
	float shortWavesFade;
};

float2 EulerFormula(float x)
{
    return float2(cos(x), sin(x));
}

float2 ComplexMul(float2 a, float2 b)
{
    return float2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}

float2 ComplexExp(float2 a) 
{
    return float2(cos(a.y), sin(a.y) * exp(a.x));
}

//Gneral Fuctions
float hash(uint n)
{
    n = (n << 13U) ^ n;
    n = n * (n * n * 15731U + 0x789221U) + 0x1376312589U;
    return float(n & uint(0x7fffffffU)) / float(0x7fffffff);
}

//用Box-Muller转换为标准正态分布的随机数
float2 gaussian(float u1, float u2)
{
    //u1&u2 are two random numbers generated by hash function
    float R = sqrt(-2 * log(u1));
    float theta = 2 * PI * u2;

    return float2(R * cos(theta), R * sin(theta));
}

//Dispersion 波浪的色散关系(用来计算omega)
float Dispersion(float k, float g, float depth)
{
	return sqrt(g * k * tanh(min(k * depth, 20)));
}

float DispersionDerivative(float k, float g, float depth)
{
	float th = tanh(min(k * depth, 20));
	float ch = cosh(k * depth);
	return g * (depth * k / ch / ch + th) / Dispersion(k, g, depth) / 2;
}

 //将方向扩展函数归一化（需要寻找依据）
float NormalizationFactor(float s)
{
    float s2 = s * s;
    float s3 = s2 * s;
    float s4 = s3 * s;

    if(s < 5)
        return -0.000564f * s4 + 0.00776f * s3 - 0.044f * s2 + 0.192f * s + 0.163f;
    else
        return -4.80e-08f * s4 + 1.07e-05f * s3 - 9.53e-04f * s2 + 5.90e-02f * s + 3.93e-01f;
}

//通用的方向扩散模型
float Cosine2s(float theta, float s)
{
    return NormalizationFactor(s) * pow(abs(cos(0.5f * theta)), 2.0f * s);
}

//方向集中度指数s(越大越集中):峰值频率处最集中,低频侧按5次幂急剧衰减(最分散),高频侧按-2.5次幂缓慢衰减
float SpreadPower(float omega, float peakOmega)
{
    float ratio = abs(omega / peakOmega);
    if(omega <= peakOmega)
        return 6.97f * pow(ratio, 5.0f);
    else
        return 9.77f * pow(ratio, -2.5f);
}

//方向分布函数,两个分支均满足 积分[-PI,PI] D(theta) dtheta = 1,且均以parameters.angle为主方向
float DirectionSpectrum(float theta, float omega, JONSWAP_parameters parameters)
{
    float s = SpreadPower(omega, parameters.peakOmega)
            + 16 * tanh(min(omega / parameters.peakOmega, 20)) * parameters.swell * parameters.swell;

    //相对主风向的夹角,两个分支必须用同一个角度,否则angle!=0时混合结果会出现双峰
    float phi = theta - parameters.angle;

    //Longuet-Higgins cos^2分布的全圆归一化形式:(1/PI)*cos^2(phi),积分[(phi-PI,phi+PI)]为1
    //注意不是(2/PI)*cos^2(phi)——那是仅在|phi|<=PI/2内有定义的半平面约定
    float cosine2 = cos(phi) * cos(phi) / PI;

    //saturate防止spreadBlend外插出负的分布
    return lerp(cosine2, Cosine2s(phi, s), saturate(parameters.spreadBlend));
}

//TMA Correction (将深水模拟修正到浅水模拟)
float TMACorrection(float omega, float g, float depth)
{
	float omegaH = omega * sqrt(depth / g);
	if (omegaH <= 1)
		return 0.5 * omegaH * omegaH;
	if (omegaH < 2)
		return 1.0 - 0.5 * (2.0 - omegaH) * (2.0 - omegaH);
	return 1;
}

float JONSWAP(float omega, float g, float depth, JONSWAP_parameters pars)
{
	float sigma;
	if (omega <= pars.peakOmega)
		sigma = 0.07;
	else
		sigma = 0.09;
	float r = exp(-(omega - pars.peakOmega) * (omega - pars.peakOmega)
		/ 2 / sigma / sigma / pars.peakOmega / pars.peakOmega);
	
	float oneOverOmega = 1 / omega;
	float peakOmegaOverOmega = pars.peakOmega / omega;
	return pars.scale * TMACorrection(omega, g, depth) * pars.alpha * g * g
		* oneOverOmega * oneOverOmega * oneOverOmega * oneOverOmega * oneOverOmega
		* exp(-1.25 * peakOmegaOverOmega * peakOmegaOverOmega * peakOmegaOverOmega * peakOmegaOverOmega)
		* pow(abs(pars.gamma), r);
}

float ShortWavesFade(float kLength, JONSWAP_parameters spectrum) 
{
	return exp(-spectrum.shortWavesFade * spectrum.shortWavesFade * kLength * kLength);
}

#endif // _OCEAN_FFT_H_